                "axes[0, 1].set_xlabel('Average Duration (minutes)', fontsize=11)\n",
                "axes[0, 1].set_title('Average Song Duration by Country', fontsize=13, fontweight='bold')\n",
                "axes[0, 1].grid(axis='x', alpha=0.3)\n",
                "\n",
                "# 3. Explicit content by region\n",
                "regional_explicit['pct'].plot(\n",
                "    kind='bar', ax=axes[1, 0], color=['#FF6B6B', '#4ECDC4', '#45B7D1']\n",
                ")\n",
                "axes[1, 0].set_xlabel('Region', fontsize=11)\n",
                "axes[1, 0].set_ylabel('Explicit Content (%)', fontsize=11)\n",
                "axes[1, 0].set_title('Explicit Content by Region', fontsize=13, fontweight='bold')\n",
                "axes[1, 0].tick_params(axis='x', rotation=45)\n",
                "axes[1, 0].grid(axis='y', alpha=0.3)\n",
                "\n",
                "# 4. Song diversity\n",
                "diversity['unique_songs'].sort_values().plot(\n",
                "    kind='barh', ax=axes[1, 1], color='#95E1D3'\n",
                ")\n",
                "axes[1, 1].set_xlabel('Number of Unique Songs', fontsize=11)\n",
                "axes[1, 1].set_title('Song Diversity by Country', fontsize=13, fontweight='bold')\n",
                "axes[1, 1].grid(axis='x', alpha=0.3)\n",
                "\n",
                "plt.tight_layout()\n",
                "plt.show()\n",
                "\n",
                "print(\"Comparative analysis reveals significant differences across countries and regions.\")"
            ]
        },
